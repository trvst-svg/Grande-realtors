                  "key": "number",
                  "value": "{{signupPhone}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{signupPassword}}",
                  "type": "text"
                },
                {
                  "key": "citizenshipFront",
                  "type": "file",
                  "src": "{{citizenshipFrontPath}}"
                },
