    {
      "name": "Properties",
      "item": [
        {
          "name": "POST Create Land Property",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"property_type\": \"land\",\n  \"location\": \"{{propertyLocation}}\",\n  \"description\": \"Prime land listing created from Postman.\",\n  \"price\": 25000000,\n  \"listing_purpose\": \"sale\",\n  \"listing_type\": \"residential\",\n  \"land\": {\n    \"area\": 5,\n    \"dimensions\": \"20x40 ft\",\n    \"road_type\": \"Pitched\",\n    \"road_access\": \"12 ft\",\n    \"property_face\": \"South\",\n    \"map_link\": \"https://maps.google.com\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/properties"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.property && data.property.id) {",
                  "    pm.environment.set('propertyId', String(data.property.id));",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
